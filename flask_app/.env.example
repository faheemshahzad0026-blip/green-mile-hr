FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string

# MySQL (URL-encode special chars in password, e.g. @ -> %40)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# Seeded / synced on app start if super admin is missing or needs update
SUPER_ADMIN_USERNAME=Green-Mile-HR
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FULL_NAME=U.Technologies

# Optional: absolute path for uploads (defaults to app/static/uploads)
# UPLOAD_FOLDER=
