FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string

# MySQL (URL-encode special chars in password, e.g. @ -> %40)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# 1) Platform super admin (U.Technologies)
SUPER_ADMIN_USERNAME=U.Technologies
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_FULL_NAME=U.Technologies

# 2) Green Mile company + agency admin (logo copied from app/static/green-mile-logo.png)
AGENCY_NAME=Green Mile
AGENCY_COMPANY_NAME=Green Mile Recycling LLC
AGENCY_ADMIN_USERNAME=Green-Mile-HR
AGENCY_ADMIN_PASSWORD=Green_Mile_HR@0112
AGENCY_ADMIN_FULL_NAME=Green Mile HR

# Optional: absolute path for uploads (defaults to app/static/uploads)
# UPLOAD_FOLDER=
