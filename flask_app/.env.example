FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string

# MySQL only (URL-encode special chars in password, e.g. @ -> %40)
# Users (U.Technologies + Green-Mile-HR) and Green Mile company/logo are seeded in the DB by flask init-db — do not put them here.
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME

# Optional: absolute path for uploads (defaults to app/static/uploads)
# UPLOAD_FOLDER=

# Optional: SMTP so HR can email app Login ID + PIN to the employee
# (cPanel example — use the company mailbox that should appear as From)
# MAIL_SERVER=mail.greenmilerecycling.com
# MAIL_PORT=465
# MAIL_USE_SSL=1
# MAIL_USE_TLS=0
# MAIL_USERNAME=hr@greenmilerecycling.com
# MAIL_PASSWORD=your-mailbox-password
# MAIL_DEFAULT_SENDER=hr@greenmilerecycling.com
