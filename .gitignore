# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# local databases, exports, and employee uploads
*.db
*.sqlite
*.sqlite3
/uploads/
/selfies/
/backups/
*.log

# private keys and certificates
*.key
*.p12
*.jks
*.keystore

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/

# Checkout-local execution profile and tool state
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/android-app/build/
